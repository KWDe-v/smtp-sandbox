{
  "name": "smtp-sandbox-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend REST API para plataforma SMTP Sandbox",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/database/migrations', 'dist/database/migrations', { recursive: true })\"",
    "start": "node dist/server.js",
    "migrate": "node dist/database/migrator.js",
    "cli": "node dist/cli.js",
    "cli:dev": "tsx src/cli.ts",
    "test:smtp": "node dist/scripts/send-test-email.js",
    "test:smtp:dev": "tsx src/scripts/send-test-email.js",
    "deploy": "tsx src/scripts/deploy-to-vps.ts",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "smtp",
    "sandbox",
    "mail",
    "api",
    "haraka",
    "dovecot"
  ],
  "author": "SMTP Sandbox",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.7.2",
    "mysql2": "^3.12.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.13.5",
    "@types/ssh2": "^1.15.5",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "ssh2": "^1.17.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
