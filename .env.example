# ==============================================================================
# SMTP Sandbox Platform - Variáveis de Ambiente
# ==============================================================================

# Ambiente geral
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Banco de Dados MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smtp_sandbox
MYSQL_USER=sandbox_user
MYSQL_PASSWORD=sandbox_secret_pass
MYSQL_ROOT_PASSWORD=root_sandbox_secret

# phpMyAdmin
PMA_PORT=8080

# Cache / Filas / Eventos Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Autenticação & JWT
JWT_SECRET=super_secret_jwt_access_key_change_in_production_min_32_bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_min_32_bytes
JWT_REFRESH_EXPIRES_IN=7d

# Servidor SMTP (Haraka)
SMTP_HOST=0.0.0.0
SMTP_PORT=25
SMTP_SUBMISSION_PORT=587
SMTP_DEFAULT_DOMAIN=sandbox.local

# Servidor IMAP (Dovecot)
IMAP_PORT=143
IMAPS_PORT=993

# Armazenamento e Anexos
STORAGE_PATH=./storage/attachments
MAX_ATTACHMENT_SIZE_MB=25
MAX_MESSAGE_SIZE_MB=50

# Webhooks & Rate Limit
WEBHOOK_SECRET=webhook_global_signing_secret_xyz123
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
